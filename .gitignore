# ============================================================
# spdt-content-cards + 学习中心 (learning-hub) 合并 .gitignore
# ============================================================

# --- spdt-content-cards 历史部分 ---
/docs/
/core/
/reports/
/views/

# --- Python ---
__pycache__/
*.py[cod]
*.class
*.pyc
*.pyo
*.so

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- 临时日志 ---
*.log
_*.log

# --- Syncthing ---
.stfolder/
.stfolder (1)/
.stversions/
syncthing-folder-*.txt
*syncthing*
*empty.txt

# --- 敏感文件 ---
.env
*.key
*_SECRET_*

# --- 临时构建 ---
/_output/
/_build/
/_tmp/

# --- 通用备份 ---
*.bak
*.bak_*
*_backup_*

# --- 学习中心特有 ---
_backup/
*.legacy.*
spdt-content-cards/   # spdt-content-cards 的副本目录（不推）
_check_*.py
_check_*.txt
_debug_*.py
_debug_*.txt
_prep.txt
.workbuddy/